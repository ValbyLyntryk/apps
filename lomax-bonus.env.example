# Copy this file to lomax-bonus.env and fill in your extra email.
# Never commit lomax-bonus.env. It contains a password.

# Where the alert should arrive
LOMAX_ALERT_EMAIL=your-extra-email@gmail.com

# Gmail (most extra Gmail accounts)
LOMAX_SMTP_HOST=smtp.gmail.com
LOMAX_SMTP_PORT=587
LOMAX_SMTP_USER=your-extra-email@gmail.com
LOMAX_SMTP_PASSWORD=paste-the-16-character-app-password-here
LOMAX_SMTP_FROM=your-extra-email@gmail.com

# Outlook / Hotmail instead of Gmail? Use these instead:
# LOMAX_SMTP_HOST=smtp.office365.com
# LOMAX_SMTP_PORT=587
