# Copy this file to spotify-invoices.env and fill it in.
# Never commit spotify-invoices.env or spotify-storage.json.

# Where the receipts should arrive (bookkeeping inbox)
SPOTIFY_ALERT_EMAIL=faktura@valbylyntryk.dk

# Gmail that SENDS the mail (can be the extra address from the Lomax setup)
SPOTIFY_SMTP_HOST=smtp.gmail.com
SPOTIFY_SMTP_PORT=587
SPOTIFY_SMTP_USER=your-extra-email@gmail.com
SPOTIFY_SMTP_PASSWORD=paste-the-16-character-app-password-here
SPOTIFY_SMTP_FROM=your-extra-email@gmail.com

# If these SMTP lines are empty, the script reuses LOMAX_SMTP_* from lomax-bonus.env.

# Outlook / Hotmail instead of Gmail? Use these instead:
# SPOTIFY_SMTP_HOST=smtp.office365.com
# SPOTIFY_SMTP_PORT=587
